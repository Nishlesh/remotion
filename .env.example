# Never commit secrets. Copy to .env locally.

# LLM (optional). Default model name is gpt-5.6-sol.
# Without OPENAI_API_KEY the factory uses the local mock (no invented facts).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FACTORY_MODEL=gpt-5.6-sol
FACTORY_LLM=mock

# Stock stills — official APIs only. Leave empty to write a search plan instead.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional override of repo root for the CLI.
# FACTORY_ROOT=
