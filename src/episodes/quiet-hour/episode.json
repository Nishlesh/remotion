  "voiceover": [
    {
      "id": "vo-01",
      "text": "There is an hour most people never keep.",
      "approximateDurationSec": 4.2
    },
    {
      "id": "vo-02",
      "text": "A desk. A window. The city still awake.",
      "approximateDurationSec": 4.0
    },
    {
      "id": "vo-03",
      "text": "You sit with a notebook and nothing to prove.",
      "approximateDurationSec": 4.4
    },
    {
      "id": "vo-04",
      "text": "Focus is not a personality. It is a room you enter.",
      "approximateDurationSec": 5.0
    },
    {
      "id": "vo-05",
      "text": "The light stays cool. The noise stays outside.",
      "approximateDurationSec": 4.4
    },
    {
      "id": "vo-06",
      "text": "One page. One line. Then another.",
      "approximateDurationSec": 3.8
    },
    {
      "id": "vo-07",
      "text": "The quiet hour is still there. You only have to keep it.",
      "approximateDurationSec": 5.2
    }
