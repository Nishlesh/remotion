  "voiceover": [
    {
      "id": "vo-01",
      "text": "Years before WhatsApp was worth billions, its founder was collecting food stamps.",
      "approximateDurationSec": 3.7100000000000004,
      "audioFile": "episodes/whatsapp-2009/audio/01.wav"
    },
    {
      "id": "vo-02",
      "text": "In 2009, Jan Koum built a tiny iPhone app that let people post statuses beside their names.",
      "approximateDurationSec": 5.11,
      "audioFile": "episodes/whatsapp-2009/audio/02.wav"
    },
    {
      "id": "vo-03",
      "text": "It wasn't even a messaging app.",
      "approximateDurationSec": 2.0300000000000002,
      "audioFile": "episodes/whatsapp-2009/audio/03.wav"
    },
    {
      "id": "vo-04",
      "text": "Then Apple introduced push notifications.",
      "approximateDurationSec": 1.75,
      "audioFile": "episodes/whatsapp-2009/audio/04.wav"
    },
    {
      "id": "vo-05",
      "text": "People started using those notifications to talk.",
      "approximateDurationSec": 2.31,
      "audioFile": "episodes/whatsapp-2009/audio/05.wav"
    },
    {
      "id": "vo-06",
      "text": "Koum noticed.",
      "approximateDurationSec": 1.6,
      "audioFile": "episodes/whatsapp-2009/audio/06.wav"
    },
    {
      "id": "vo-07",
      "text": "And WhatsApp became a messenger.",
      "approximateDurationSec": 1.75,
      "audioFile": "episodes/whatsapp-2009/audio/07.wav"
    },
    {
      "id": "vo-08",
      "text": "Years later, Facebook acquired it for billions.",
      "approximateDurationSec": 2.31,
      "audioFile": "episodes/whatsapp-2009/audio/08.wav"
    },
    {
      "id": "vo-09",
      "text": "Koum signed the deal at a social services office—",
      "approximateDurationSec": 2.8700000000000006,
      "audioFile": "episodes/whatsapp-2009/audio/09.wav"
    },
    {
      "id": "vo-10",
      "text": "the same kind of office where he once collected food stamps.",
      "approximateDurationSec": 3.43,
      "audioFile": "episodes/whatsapp-2009/audio/10.wav"
    },
    {
      "id": "vo-11",
      "text": "He didn't know what WhatsApp would become.",
      "approximateDurationSec": 2.31,
      "audioFile": "episodes/whatsapp-2009/audio/11.wav"
    },
    {
      "id": "vo-12",
      "text": "He just kept building.",
      "approximateDurationSec": 1.6,
      "audioFile": "episodes/whatsapp-2009/audio/12.wav"
    },
    {
      "id": "vo-13",
      "text": "If you're building something after work, FocusStack helps you keep showing up.",
      "approximateDurationSec": 3.7100000000000004,
      "audioFile": "episodes/whatsapp-2009/audio/13.wav"
    }
  ],
