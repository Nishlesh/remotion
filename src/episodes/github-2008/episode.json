  "voiceover": [
    {
      "id": "vo-01",
      "text": "GitHub started at 10:24 on a Friday night.",
      "approximateDurationSec": 3.791,
      "audioFile": "episodes/github-2008/audio/01.wav"
    },
    {
      "id": "vo-02",
      "text": "Chris Wanstrath made the first commit. October 19th, 2007.",
      "approximateDurationSec": 5.476,
      "audioFile": "episodes/github-2008/audio/02.wav"
    },
    {
      "id": "vo-03",
      "text": "Tom Preston-Werner still had a day job. Tools developer at Powerset. Full time.",
      "approximateDurationSec": 6.094,
      "audioFile": "episodes/github-2008/audio/03.wav"
    },
    {
      "id": "vo-04",
      "text": "Chris was consulting. They met every Saturday.",
      "approximateDurationSec": 3.417,
      "audioFile": "episodes/github-2008/audio/04.wav"
    },
    {
      "id": "vo-05",
      "text": "Tom built Grit and the interface. Chris built the Rails app.",
      "approximateDurationSec": 4.367,
      "audioFile": "episodes/github-2008/audio/05.wav"
    },
    {
      "id": "vo-06",
      "text": "Three months of nights and weekends. Design and pricing on Saturday.",
      "approximateDurationSec": 4.729,
      "audioFile": "episodes/github-2008/audio/06.wav"
    },
    {
      "id": "vo-07",
      "text": "They let friends in that January. PJ Hyett became the third co-founder a month later.",
      "approximateDurationSec": 6.507,
      "audioFile": "episodes/github-2008/audio/07.wav"
    },
    {
      "id": "vo-08",
      "text": "April 10th, 2008. They opened it to everyone. Three twenty-somethings. No outside investment.",
      "approximateDurationSec": 7.804,
      "audioFile": "episodes/github-2008/audio/08.wav"
    }
  ],
