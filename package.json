{
  "name": "before-it-was-famous",
  "version": "1.0.0",
  "description": "Before It Was Famous YouTube Shorts factory — Remotion compositor, karaoke, typed episode pipeline",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "factory": "tsx src/factory/cli.ts",
    "fixture:media": "tsx src/factory/generateFixtureMedia.ts",
    "preview": "remotion studio",
    "render": "remotion render Github2008 out/github-2008.mp4 --timeout=120000",
    "render:fixture": "tsx src/factory/cli.ts render --episode _fixture-pipeline",
    "render:quiet-hour": "remotion render QuietHour out/quiet-hour.mp4",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@remotion/cli": "4.0.518",
    "@remotion/google-fonts": "4.0.518",
    "@remotion/media-utils": "4.0.518",
    "@remotion/zod-types": "4.0.518",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.518",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "prettier": "3.8.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
