  "voiceover": [
    {
      "id": "vo-01",
      "text": "Before Dyson's bagless vacuum conquered living rooms,",
      "approximateDurationSec": 4.104,
      "audioFile": "episodes/dyson-5126/audio/01.wav"
    },
    {
      "id": "vo-02",
      "text": "he built 5,126 that failed.",
      "approximateDurationSec": 4.176,
      "audioFile": "episodes/dyson-5126/audio/02.wav"
    },
    {
      "id": "vo-03",
      "text": "He wanted a vacuum cleaner that would not lose suction.",
      "approximateDurationSec": 3.96,
      "audioFile": "episodes/dyson-5126/audio/03.wav"
    },
    {
      "id": "vo-04",
      "text": "Prototype after prototype for five years.",
      "approximateDurationSec": 3.552,
      "audioFile": "episodes/dyson-5126/audio/04.wav"
    },
    {
      "id": "vo-05",
      "text": "Manufacturers still rejected the one that worked.",
      "approximateDurationSec": 3.912,
      "audioFile": "episodes/dyson-5126/audio/05.wav"
    },
    {
      "id": "vo-06",
      "text": "Bags paid their bills.",
      "approximateDurationSec": 2.496,
      "audioFile": "episodes/dyson-5126/audio/06.wav"
    },
    {
      "id": "vo-07",
      "text": "So he stopped asking permission.",
      "approximateDurationSec": 2.904,
      "audioFile": "episodes/dyson-5126/audio/07.wav"
    },
    {
      "id": "vo-08",
      "text": "He sold the machine himself.",
      "approximateDurationSec": 2.712,
      "audioFile": "episodes/dyson-5126/audio/08.wav"
    },
    {
      "id": "vo-09",
      "text": "It became a massive success.",
      "approximateDurationSec": 2.856,
      "audioFile": "episodes/dyson-5126/audio/09.wav"
    },
    {
      "id": "vo-10",
      "text": "The machine everyone remembers needed the 5,126 nobody wanted.",
      "approximateDurationSec": 5.952,
      "audioFile": "episodes/dyson-5126/audio/10.wav"
    },
    {
      "id": "vo-11",
      "text": "Breakthroughs rarely look like breakthroughs mid-build.",
      "approximateDurationSec": 3.624,
      "audioFile": "episodes/dyson-5126/audio/11.wav"
    },
    {
      "id": "vo-12",
      "text": "If you're still on the next prototype, FocusStack helps you keep showing up.",
      "approximateDurationSec": 5.112,
      "audioFile": "episodes/dyson-5126/audio/12.wav"
    }
  ],
